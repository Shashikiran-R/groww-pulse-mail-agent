# --- LLM ---
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq

# --- App Target ---
APP_ID=com.nextbillion.groww
LOOKBACK_WEEKS=520

# --- Google OAuth (used by MCP servers) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Delivery (Email & Google Docs) ---
EMAIL_TO=recipient@example.com
# Multiple comma-separated recipients can also be set:
# PULSE_EMAIL_RECIPIENTS=user1@example.com,user2@example.com
GROWW_PULSE_DOC_URL=https://docs.google.com/document/d/YOUR_DOC_ID/edit
DOC_TITLE_PREFIX=Groww Weekly Pulse

# --- MCP Transport (stdio for local, sse for remote Render server) ---
MCP_SERVER_URL=https://aiagentserver.onrender.com
MCP_AUTH_TOKEN=your-mcp-auth-token
MCP_TRANSPORT=sse

# --- Data Pipeline ---
MIN_REVIEW_LENGTH=10
LANGUAGE_CONFIDENCE_THRESHOLD=0.8
SPAM_SIMILARITY_THRESHOLD=0.95
SENTIMENT_WEIGHTS=0.4,0.4,0.2

# --- Classification ---
LLM_BATCH_SIZE=50
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6

# --- Schedule ---
RUN_DAY=monday
RUN_HOUR=9
